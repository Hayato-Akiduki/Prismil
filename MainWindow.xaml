<Window x:Class="ZenTube.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:svc="clr-namespace:ZenTube.Services"
        Title="Prismil" Icon="Assets/prismil.ico" Height="880" Width="1440" MinWidth="820" MinHeight="520"
        Background="#0D0F14" Foreground="#F1F5F9"
        FontFamily="Segoe UI Variable Text, Yu Gothic UI, Meiryo UI">

    <Window.Resources>
        <!-- サムネイルを表示サイズに縮めて読み込む -->
        <svc:ThumbnailConverter x:Key="ThumbConverter"/>
        <!-- 左ナビゲーションのメニューボタン -->
        <Style x:Key="NavMenuButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="10,1.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                <Border x:Name="Badge" Grid.Column="1" CornerRadius="10" Background="#1AFFFFFF"
                                        Padding="7,2" VerticalAlignment="Center" Visibility="Visible">
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="11" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="">
                                <Setter TargetName="Badge" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter TargetName="Badge" Property="Background" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 「サイト別に見る」のボタン -->
        <Style x:Key="SiteFilterRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="10,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,10,0"
                                        Background="{TemplateBinding Tag}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF"/>
                                <Setter Property="Foreground" Value="#E2E8F0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- トピックチップボタン -->
        <Style x:Key="TopicChipButton" TargetType="Button">
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 汎用アクションボタン -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- プライマリボタン -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#4F46E5"/>
            <Setter Property="BorderBrush" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6366F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- アイコンだけの控えめなボタン（枠なし・ホバーで薄く光る） -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 読み込むサイトのON/OFFチップ（色の点＋サイト名） -->
        <Style x:Key="SiteToggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#7C8798"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#14FFFFFF" BorderThickness="1"
                                CornerRadius="6" Padding="8,6">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"
                                        Background="{TemplateBinding Tag}" Opacity="0.3" VerticalAlignment="Center"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#24FFFFFF"/>
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 「⋯」メニューの1行ぶんのボタン -->
        <Style x:Key="MenuRowBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="#B30E1016">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 画面全体のアンビエントライト：再生中の動画の色（左・中央・右）を背面ににじませる -->
        <Grid x:Name="AmbientLayer" Grid.ColumnSpan="2" IsHitTestVisible="False" Opacity="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop x:Name="AmbientStopLeft" Color="#00000000" Offset="0"/>
                    <GradientStop x:Name="AmbientStopCenter" Color="#00000000" Offset="0.5"/>
                    <GradientStop x:Name="AmbientStopRight" Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <!-- 下に向かって暗くして、文字が読みにくくならないようにする -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#99000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- ==================== 左サイドバー ==================== -->
        <!-- 開閉アニメーション用：列の幅が縮むと、中身が左へスライドして隠れる -->
        <Grid Grid.Column="0" ClipToBounds="True">
        <Border Width="236" HorizontalAlignment="Right" Background="#1A000000" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- ロゴヘッダー -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,16,14,12">
                    <Image Source="Assets/prismil.png" Width="36" Height="36" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Prismil" Foreground="White" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="プリズミル" Foreground="#9AA4B5" FontSize="10" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <!-- 下部：再生中ミニカード＆サイト直接アクセス -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,10">
                    <!-- 再生中ミニカード（一覧画面を見ている時に表示） -->
                    <Border x:Name="NowPlayingMiniCard" Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1"
                            CornerRadius="10" Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="🎵 再生中" Foreground="#818CF8" FontSize="11" FontWeight="Bold"/>
                                <Button Content="✕" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                                        Cursor="Hand" Click="StopPlayback_Click" ToolTip="再生を停止"/>
                            </DockPanel>
                            <TextBlock x:Name="MiniNowPlayingTitle" Text="" Foreground="White" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2">
                                <Button Content="🎬 プレイヤー" Style="{StaticResource PrimaryBtn}"
                                        Margin="0,0,3,0" Padding="4,4" FontSize="11" Click="SwitchToPlayer_Click"/>
                                <Button Content="🗗 ミニ窓化" Style="{StaticResource ActionBtn}"
                                        Margin="3,0,0,0" Padding="4,4" FontSize="11" Click="MiniPlayerButton_Click"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- ローカルプライバシー保護ステータス（ログイン不要・PC内完結） -->
                    <Border Background="#0AFFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock Text="🔒 ログイン不要・ローカル完結" Foreground="#34D399" FontSize="10.5" FontWeight="Bold"/>
                            <TextBlock Text="チャンネル登録・履歴はこのPCのみに保存（消去などは ⚙ 設定 から）" Foreground="#9AA4B5" FontSize="9.5"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Foreground="#7C8798" FontSize="10" Text="Ctrl+B: メニュー / Ctrl+L: 検索 / Ctrl+M: ミニ窓 / F11: 全画面"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 中央スクロール領域（ナビ・マイプレイリスト・サイト別に見る） -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="DISCOVER" Foreground="#7C8798" FontSize="10.5"
                                   FontWeight="Bold" Margin="20,4,0,2"/>
                        <RadioButton x:Name="NavHome" Content="🔥  トレンド・おすすめ"
                                     Style="{StaticResource NavMenuButton}" GroupName="MainNav" Checked="MainNav_Checked"/>
                        <RadioButton x:Name="NavMusicMode" Content="🎧  Musicモード (音楽特化)"
                                     Style="{StaticResource NavMenuButton}" GroupName="MainNav" Checked="MainNav_Checked"/>
                        <RadioButton x:Name="NavSubscriptionsFeed" Content="📡  登録チャンネル新着"
                                     Style="{StaticResource NavMenuButton}" GroupName="MainNav" Checked="MainNav_Checked"/>
                        <RadioButton x:Name="NavSearch" Content="🔍  横断検索結果"
                                     Style="{StaticResource NavMenuButton}" GroupName="MainNav" Checked="MainNav_Checked"/>

                        <TextBlock Text="MY LIBRARY (このPCのみ)" Foreground="#7C8798" FontSize="10.5"
                                   FontWeight="Bold" Margin="20,12,0,2"/>
                        <RadioButton x:Name="NavFavorites" Content="♥  お気に入り"
                                     Style="{StaticResource NavMenuButton}" GroupName="MainNav" Checked="MainNav_Checked"/>
                        <RadioButton x:Name="NavWatchLater" Content="🕒  後で見る"
                                     Style="{StaticResource NavMenuButton}" GroupName="MainNav" Checked="MainNav_Checked"/>
                        <RadioButton x:Name="NavHistory" Content="📜  視聴履歴"
                                     Style="{StaticResource NavMenuButton}" GroupName="MainNav" Checked="MainNav_Checked"/>
                        <RadioButton x:Name="NavStats" Content="📊  視聴統計・分析"
                                     Style="{StaticResource NavMenuButton}" GroupName="MainNav" Checked="MainNav_Checked"/>
                        <RadioButton x:Name="NavSettings" Content="⚙  設定"
                                     Style="{StaticResource NavMenuButton}" GroupName="MainNav" Checked="MainNav_Checked"/>

                        <!-- ローカル登録チャンネル一覧 -->
                        <TextBlock Text="SUBSCRIPTIONS (登録チャンネル)" Foreground="#7C8798" FontSize="10.5"
                                   FontWeight="Bold" Margin="20,12,0,2"/>
                        <ItemsControl x:Name="SubscriptionsNavControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding Name}" Tag="{Binding SiteDotBrush}"
                                                 DataContext="{Binding}"
                                                 Style="{StaticResource SiteFilterRadio}" GroupName="MainNav"
                                                 Checked="ChannelNav_Checked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- カスタムプレイリスト一覧 -->
                        <TextBlock Text="CUSTOM PLAYLISTS" Foreground="#7C8798" FontSize="10.5"
                                   FontWeight="Bold" Margin="20,12,0,4"/>
                        <ItemsControl x:Name="PlaylistsNavControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding Name}" Tag="{Binding CountText}"
                                                 DataContext="{Binding}"
                                                 Style="{StaticResource NavMenuButton}" GroupName="MainNav"
                                                 Checked="PlaylistNav_Checked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 新規プレイリスト作成フォーム -->
                        <Border Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                CornerRadius="8" Margin="12,4,12,2" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <TextBox x:Name="NewPlaylistNameBox" Background="Transparent" BorderThickness="0"
                                             Foreground="White" CaretBrush="#818CF8" FontSize="12"
                                             VerticalContentAlignment="Center" KeyDown="NewPlaylistNameBox_KeyDown"
                                             TextChanged="NewPlaylistNameBox_TextChanged"/>
                                    <TextBlock x:Name="NewPlaylistHint" Text="＋ 新規リスト名..."
                                               Foreground="#9AA4B5" FontSize="11.5" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Grid>
                                <Button Grid.Column="1" Content="作成" Style="{StaticResource PrimaryBtn}"
                                        Padding="8,2" FontSize="11" Click="CreatePlaylist_Click"/>
                            </Grid>
                        </Border>

                        <!-- サイト別に見る（選んだサイトの検索結果・おすすめだけを表示） -->
                        <TextBlock Text="🌐 サイト別に見る" Foreground="#AEB8C8" FontSize="12"
                                   FontWeight="Bold" Margin="20,14,0,0"/>
                        <TextBlock Text="サイトを選ぶと、そのサイトの動画を見るモードになります（ABEMA はここでだけ表示）" Foreground="#7C8798" FontSize="10.5"
                                   TextWrapping="Wrap" Margin="20,2,12,4"/>
                        <RadioButton x:Name="FilterAll" Content="すべてのサイト" Tag="#818CF8"
                                     Style="{StaticResource SiteFilterRadio}" GroupName="SiteFilter" IsChecked="True" Checked="SiteFilter_Checked"/>
                        <RadioButton x:Name="FilterYouTube" Content="YouTube" Tag="#FF0033"
                                     Style="{StaticResource SiteFilterRadio}" GroupName="SiteFilter" Checked="SiteFilter_Checked"/>
                        <RadioButton x:Name="FilterNiconico" Content="ニコニコ動画" Tag="#E2E8F0"
                                     Style="{StaticResource SiteFilterRadio}" GroupName="SiteFilter" Checked="SiteFilter_Checked"/>
                        <RadioButton x:Name="FilterSoundCloud" Content="SoundCloud (音楽/音源)" Tag="#FF5500"
                                     Style="{StaticResource SiteFilterRadio}" GroupName="SiteFilter" Checked="SiteFilter_Checked"/>
                        <RadioButton x:Name="FilterPodcast" Content="Podcast (ラジオ番組)" Tag="#8B5CF6"
                                     Style="{StaticResource SiteFilterRadio}" GroupName="SiteFilter" Checked="SiteFilter_Checked"/>
                        <RadioButton x:Name="FilterRadio" Content="ネットラジオ (24h生放送)" Tag="#0EA5E9"
                                     Style="{StaticResource SiteFilterRadio}" GroupName="SiteFilter" Checked="SiteFilter_Checked"/>
                        <RadioButton x:Name="FilterBilibili" Content="bilibili" Tag="#00A1D6"
                                     Style="{StaticResource SiteFilterRadio}" GroupName="SiteFilter" Checked="SiteFilter_Checked"/>
                        <RadioButton x:Name="FilterTwitch" Content="Twitch (生配信/動画)" Tag="#9146FF"
                                     Style="{StaticResource SiteFilterRadio}" GroupName="SiteFilter" Checked="SiteFilter_Checked"/>
                        <RadioButton x:Name="FilterAbema" Content="ABEMA (TV/見逃し)" Tag="#00B94B"
                                     Style="{StaticResource SiteFilterRadio}" GroupName="SiteFilter" Checked="SiteFilter_Checked"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
        </Grid>

        <!-- ==================== 右メイン領域 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="62"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 上部：横断検索バー ＆ 広告ブロック・スリープタイマー・モード切替 -->
            <Border x:Name="TopToolbar" Grid.Row="0" Background="#1A000000" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左サイドバーの表示/非表示 -->
                    <!-- 開いている時は「パネルを閉じる」、閉じている時は「パネルを開く＋メニュー」の表示に切り替わる -->
                    <Button x:Name="BtnToggleSidebar" Grid.Column="0" Style="{StaticResource IconBtn}"
                            MinWidth="36" Height="32" Padding="9,3" Margin="0,0,10,0"
                            Click="ToggleSidebar_Click" ToolTip="メニューを隠す (Ctrl+B)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SidebarToggleIcon" Text="&#xE8A0;" FontSize="15"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SidebarToggleLabel" Text="メニュー" FontSize="12.5" Margin="7,0,0,0"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>

                    <!-- 横断検索ボックス -->
                    <Border Grid.Column="1" MaxWidth="640" HorizontalAlignment="Stretch" Margin="0,11,16,11"
                            CornerRadius="10" Background="#14FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13.5" Foreground="#9AA4B5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                         Foreground="White" CaretBrush="#818CF8" FontSize="13"
                                         VerticalContentAlignment="Center"
                                         KeyDown="SearchBox_KeyDown"
                                         TextChanged="SearchBox_TextChanged"
                                         GotKeyboardFocus="SearchBox_GotKeyboardFocus"/>
                                <TextBlock x:Name="SearchHint"
                                           Text="動画を検索、またはURLを貼り付け"
                                           Foreground="#9AA4B5" FontSize="12" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                            <!-- 検索するサイトの選択（左の「サイト別に見る」と連動） -->
                            <ComboBox x:Name="SearchSiteCombo" Grid.Column="2" Width="128" Height="28" Margin="4,0,0,0"
                                      VerticalContentAlignment="Center" FontSize="12"
                                      SelectionChanged="SearchSiteCombo_SelectionChanged"
                                      ToolTip="検索するサイトを選ぶ（左の「サイト別に見る」と同じ。1サイトにすると、そのサイトの結果だけを多めに表示します）"/>
                            <Button x:Name="SearchButton" Grid.Column="3" Content="検索" Style="{StaticResource PrimaryBtn}"
                                    Margin="4,4,5,4" Padding="12,0" Click="SearchButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- 右側：よく使うものだけ表示。その他は「⋯」メニューにまとめる -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="SortCombo" Width="120" Height="32" VerticalContentAlignment="Center"
                                  SelectionChanged="SortCombo_SelectionChanged" Margin="0,0,6,0" ToolTip="一覧の並び順">
                            <ComboBoxItem Content="バランス順" IsSelected="True"/>
                            <ComboBoxItem Content="再生数が多い順"/>
                            <ComboBoxItem Content="動画が長い順"/>
                            <ComboBoxItem Content="動画が短い順"/>
                        </ComboBox>

                        <Button x:Name="BtnToggleViewMode" Content="🎬 プレイヤー" Style="{StaticResource ActionBtn}"
                                Height="32" Margin="0,0,6,0" Click="ToggleViewMode_Click" ToolTip="カード一覧とプレイヤー画面を切り替え"/>

                        <Button x:Name="BtnMoreMenu" Content="⋯" Style="{StaticResource IconBtn}"
                                Width="36" Height="32" FontSize="16" Click="MoreMenuButton_Click" ToolTip="その他の機能"/>

                        <!-- 「⋯」メニューの中身 -->
                        <Popup x:Name="MoreMenuPopup" PlacementTarget="{Binding ElementName=BtnMoreMenu}"
                               Placement="Bottom" HorizontalOffset="-224" VerticalOffset="6"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               Closed="MoreMenuPopup_Closed">
                            <Border Width="260" Background="#FF1C1F27" BorderBrush="#1AFFFFFF" BorderThickness="1"
                                    CornerRadius="10" Padding="6">
                                <StackPanel ButtonBase.Click="MoreMenuItem_Click">
                                    <Button x:Name="BtnMusicMode" Content="🎧 Musicモード" Style="{StaticResource MenuRowBtn}"
                                            Click="MusicModeButton_Click"
                                            ToolTip="音楽専用ステーション＆バックグラウンド連続再生モードへ切替"/>
                                    <Button x:Name="BtnGacha" Content="🎲 動画ガチャ" Style="{StaticResource MenuRowBtn}"
                                            Click="VideoGacha_Click"
                                            ToolTip="5サイトからランダムなテーマで面白い動画・音楽・配信を10連抽選して発掘！"/>

                                    <Button x:Name="BtnOpenSettings" Content="⚙ 設定" Style="{StaticResource MenuRowBtn}"
                                            Click="OpenSettings_Click"
                                            ToolTip="再生・映像と音・一覧・広告・データなどの細かい設定"/>

                                    <Border Height="1" Background="#14FFFFFF" Margin="6,5"/>

                                    <!-- スリープタイマー -->
                                    <DockPanel Margin="10,4,4,2">
                                        <ComboBox x:Name="SleepTimerCombo" DockPanel.Dock="Right" Width="130" Height="30"
                                                  VerticalContentAlignment="Center"
                                                  SelectionChanged="SleepTimerCombo_SelectionChanged"
                                                  ToolTip="指定時間後に再生を自動停止するスリープタイマー">
                                            <ComboBoxItem x:Name="SleepTimerOffItem" Content="OFF" Tag="0" IsSelected="True"/>
                                            <ComboBoxItem Content="15分後に停止" Tag="15"/>
                                            <ComboBoxItem Content="30分後に停止" Tag="30"/>
                                            <ComboBoxItem Content="45分後に停止" Tag="45"/>
                                            <ComboBoxItem Content="60分後に停止" Tag="60"/>
                                            <ComboBoxItem Content="90分後に停止" Tag="90"/>
                                        </ComboBox>
                                        <TextBlock Text="🌙 スリープタイマー" Foreground="#E2E8F0" FontSize="12.5" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- メインコンテンツ領域（カード一覧画面 と クリーンプレイヤー画面） -->
            <Grid Grid.Row="1">

                <!-- ========== 1. 独自カード一覧画面 (Discover / Search / Library / Playlist) ========== -->
                <Grid x:Name="CardBrowserView" Background="#00000000">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- セクションタイトル＆クイックトピックチップ -->
                    <StackPanel Grid.Row="0" Margin="24,16,24,8">
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ViewHeaderTitle" Text="🔥 3サイト横断トレンド"
                                           Foreground="White" FontSize="20" FontWeight="Bold"/>
                                <Border Background="#14FFFFFF" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ViewHeaderCount" Text="0 件" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <!-- ランダム1本即再生ボタン -->
                                <Button Content="🎯 おまかせ再生" Style="{StaticResource ActionBtn}"
                                        Margin="0,0,8,0" Click="PlayRandomOne_Click"
                                        ToolTip="現在の一覧からランダムに1本選んですぐ再生します"/>

                                <!-- 登録チャンネル個別表示時の解除ボタン -->
                                <Button x:Name="BtnUnsubscribeChannel" Content="★ チャンネル登録を解除" Style="{StaticResource ActionBtn}"
                                        Visibility="Collapsed" Margin="0,0,8,0" Click="UnsubscribeCurrentChannel_Click"/>

                                <!-- カスタムプレイリスト表示時専用ボタン -->
                                <Button x:Name="BtnPlayAllPlaylist" Content="▶ このリストを連続再生" Style="{StaticResource PrimaryBtn}"
                                        Visibility="Collapsed" Margin="0,0,8,0" Click="PlayAllPlaylist_Click"/>
                                <Button x:Name="BtnDeletePlaylist" Content="🗑 リストを削除" Style="{StaticResource ActionBtn}"
                                        Visibility="Collapsed" Margin="0,0,8,0" Click="DeleteCurrentPlaylist_Click"/>

                                <Button x:Name="BtnClearHistory" Content="🗑 履歴をすべて消去" Style="{StaticResource ActionBtn}"
                                        Visibility="Collapsed" Margin="0,0,8,0" Click="ClearHistory_Click"/>
                                <Button Content="⟳ 更新" Style="{StaticResource ActionBtn}" Click="RefreshFeed_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- 🎧 Musicモード専用：ジャンル＆ムード・ステーションバー + ラジオ＆Podcastステーション -->
                        <Border x:Name="MusicStationBar" Visibility="Collapsed" CornerRadius="12" Padding="14,12" Margin="0,0,0,10"
                                Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎧 ZEN MUSIC &amp; RADIO HUB" Foreground="#F472B6" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text=" — 音楽・作業用BGM・24時間ネットラジオ生放送・人気Podcast番組を1クリック選曲"
                                                   Foreground="#CBD5E1" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnMusicBgListenToggle" Content="🎧 クリック時は下部バーでBGM再生: ON"
                                                Style="{StaticResource ActionBtn}"
                                                Padding="10,3" FontSize="11" Click="MusicBgListenToggle_Click"
                                                ToolTip="ON: 曲・ラジオ・Podcastをクリックしても一覧画面のまま下部プレイヤーバーで再生を続けます / OFF: クリック時にプレイヤー画面を開きます"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- 1段目：音楽＆BGMステーション -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎵 音楽:" Foreground="#F472B6" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="🔥 J-POP / 邦楽ヒット" Style="{StaticResource TopicChipButton}" Click="MusicStation_Click" Tag="YOASOBI 米津玄師 Ado Official MV J-POP"/>
                                        <Button Content="🎤 ボカロ / 歌ってみた" Style="{StaticResource TopicChipButton}" Click="MusicStation_Click" Tag="VOCALOID 初音ミク ボカロ 歌ってみた 名曲"/>
                                        <Button Content="☁ SoundCloud トレンド" Style="{StaticResource TopicChipButton}" Click="MusicStationSoundCloud_Click" Tag="J-POP Anime Vocaloid Future Bass Remix"/>
                                        <Button Content="🎹 作業用 Lo-Fi / Chill" Style="{StaticResource TopicChipButton}" Click="MusicStation_Click" Tag="Lofi Hip Hop Chill Beats 作業用BGM 勉強用"/>
                                        <Button Content="🎸 アニソン / ゲーム神曲" Style="{StaticResource TopicChipButton}" Click="MusicStation_Click" Tag="アニソン 神曲 ゲーム音楽 OST 主題歌"/>
                                        <Button Content="🎧 EDM / Nightcore / Remix" Style="{StaticResource TopicChipButton}" Click="MusicStation_Click" Tag="EDM Nightcore Kawaii Future Bass Remix"/>
                                        <Button Content="☕ カフェジャズ / ピアノ" Style="{StaticResource TopicChipButton}" Click="MusicStation_Click" Tag="カフェ ジャズ ピアノ BGM Relaxing Piano Jazz"/>
                                        <Button Content="🌙 深夜の睡眠・環境音" Style="{StaticResource TopicChipButton}" Click="MusicStation_Click" Tag="睡眠用BGM 雨音 Ambient Sleep Music"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- 2段目：📻 ネットラジオ生放送 ＆ 🎙 ポッドキャスト番組 -->
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📻 ラジオ &amp; Podcast:" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Button Content="🎙 人気ラジオ番組・芸人トーク" Style="{StaticResource TopicChipButton}"
                                                Click="MusicStation_Click" Tag="podcast:ラジオショー オールナイトニッポン 芸人 ラジオ"/>
                                        <Button Content="🎙 ニュース・経済・時事Podcast" Style="{StaticResource TopicChipButton}"
                                                Click="MusicStation_Click" Tag="podcast:ニュース 経済 解説 新聞"/>
                                        <Button Content="🎙 歴史・科学・教養・雑学" Style="{StaticResource TopicChipButton}"
                                                Click="MusicStation_Click" Tag="podcast:歴史 教養 科学 コテン 雑談"/>
                                        <Button Content="🎙 英語リスニング・ITテック" Style="{StaticResource TopicChipButton}"
                                                Click="MusicStation_Click" Tag="podcast:英語 英会話 テクノロジー IT"/>
                                        <Button Content="📻 日本のネットラジオ局 (JP LIVE)" Style="{StaticResource TopicChipButton}"
                                                Click="MusicStation_Click" Tag="radio:JP"/>
                                        <Button Content="📻 24h Lo-Fi / Chill Radio" Style="{StaticResource TopicChipButton}"
                                                Click="MusicStation_Click" Tag="radio:lofi"/>
                                        <Button Content="📻 24h J-POP / Anime Radio" Style="{StaticResource TopicChipButton}"
                                                Click="MusicStation_Click" Tag="radio:anime"/>
                                        <Button Content="📻 24h Jazz / Classical Radio" Style="{StaticResource TopicChipButton}"
                                                Click="MusicStation_Click" Tag="radio:jazz"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- トピックワンクリック検索チップ ＋ 最近の検索ワード履歴 -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="🔥 5サイト総合" Style="{StaticResource TopicChipButton}" Click="TopicChip_Click" Tag=""/>
                                <Button Content="☁ SoundCloud 音楽" Style="{StaticResource TopicChipButton}" Click="QuickSiteFilterChip_Click" Tag="SoundCloud"/>
                                <Button Content="🔴 Twitch 生配信" Style="{StaticResource TopicChipButton}" Click="QuickSiteFilterChip_Click" Tag="Twitch"/>
                                <Button Content="📺 ABEMA 放送中" Style="{StaticResource TopicChipButton}" Click="QuickSiteFilterChip_Click" Tag="Abema"/>
                                <Button Content="🎵 音楽 / 公式MV" Style="{StaticResource TopicChipButton}" Click="TopicChip_Click" Tag="Official Music Video MV"/>
                                <Button Content="🎤 ボカロ / 歌ってみた" Style="{StaticResource TopicChipButton}" Click="TopicChip_Click" Tag="VOCALOID ボカロ 歌ってみた"/>
                                <Button Content="🎮 ゲーム実況 / 配信" Style="{StaticResource TopicChipButton}" Click="TopicChip_Click" Tag="ゲーム実況 VALORANT Apex"/>
                                <Button Content="🎬 アニメ / MAD" Style="{StaticResource TopicChipButton}" Click="TopicChip_Click" Tag="アニメ PV MAD"/>
                                <Button Content="☕ 作業用BGM / Lo-Fi" Style="{StaticResource TopicChipButton}" Click="TopicChip_Click" Tag="作業用BGM Chill Lofi"/>

                                <ItemsControl x:Name="RecentSearchesControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Tag="{Binding}"
                                                    Style="{StaticResource TopicChipButton}"
                                                    Click="RecentSearchChip_Click" ToolTip="最近の検索ワードで再検索"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- カードグリッド一覧 -->
                    <Grid Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 一覧は「行」単位で、画面に見えている行だけを作る（仮想化）。件数が多くても軽く保つため -->
                            <ItemsControl x:Name="VideoCardsControl" Padding="20,4,20,12"
                                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                          SizeChanged="VideoCardsControl_SizeChanged">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer x:Name="CardsScrollViewer" VerticalScrollBarVisibility="Auto"
                                                      CanContentScroll="True" Focusable="False" Padding="{TemplateBinding Padding}">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- 個別動画カード -->
                                                <Border Width="278" Margin="6,8" CornerRadius="12"
                                                        Background="#0DFFFFFF" BorderBrush="#00000000" BorderThickness="1">
                                                    <StackPanel>
                                                        <!-- サムネイル領域 (クリックで再生) -->
                                                        <Button Cursor="Hand" Click="PlayVideoCard_Click" Tag="{Binding}"
                                                                Background="Transparent" BorderThickness="0" Padding="0">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border CornerRadius="11,11,0,0" ClipToBounds="True" Height="156" Background="#33000000">
                                                                        <Grid>
                                                                            <Image Source="{Binding ThumbnailUrl, Converter={StaticResource ThumbConverter}, ConverterParameter=440}" Stretch="UniformToFill"/>

                                                                            <!-- 左上：サイトバッジ -->
                                                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                                    Margin="8,8,0,0" CornerRadius="6" Padding="8,3"
                                                                                    Background="{Binding SiteBadgeBrush}">
                                                                                <TextBlock Text="{Binding SiteDisplayName}" Foreground="White"
                                                                                           FontSize="10.5" FontWeight="Bold"/>
                                                                            </Border>

                                                                            <!-- 右下：再生時間 -->
                                                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                                    Margin="0,0,8,8" CornerRadius="5" Padding="6,2"
                                                                                    Background="#CC000000">
                                                                                <TextBlock Text="{Binding DurationText}" Foreground="White"
                                                                                           FontSize="11" FontWeight="SemiBold"/>
                                                                            </Border>

                                                                            <!-- ホバー時の再生オーバーレイ -->
                                                                            <Border x:Name="HoverOverlay" Background="#55000000" Opacity="0">
                                                                                <Border Width="46" Height="46" CornerRadius="23" Background="#DD4F46E5"
                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                    <TextBlock Text="▶" Foreground="White" FontSize="18"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                                                </Border>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="1"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>

                                                        <!-- テキスト＆アクション領域 -->
                                                        <StackPanel Margin="12,10,12,12">
                                                            <TextBlock Text="{Binding Title}" Foreground="#F1F5F9" FontSize="13.5"
                                                                       FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38"
                                                                       TextTrimming="CharacterEllipsis" Height="38"
                                                                       ToolTip="{Binding Title}" Cursor="Hand"
                                                                       MouseLeftButtonUp="VideoTitle_MouseLeftButtonUp" Tag="{Binding}"/>

                                                            <DockPanel Margin="0,6,0,2">
                                                                <Button DockPanel.Dock="Right" Content="{Binding SubscribeIcon}"
                                                                        Foreground="{Binding SubscribeForeground}"
                                                                        Background="Transparent" BorderThickness="0"
                                                                        FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                                                                        Padding="4,0" Click="ToggleSubscribeCard_Click" Tag="{Binding}"
                                                                        ToolTip="ログイン不要でこのアプリ内にチャンネル登録 / 解除"/>
                                                                <TextBlock Text="{Binding Author}" Foreground="#94A3B8" FontSize="11.5"
                                                                           TextTrimming="CharacterEllipsis" Cursor="Hand"
                                                                           MouseLeftButtonUp="AuthorName_MouseLeftButtonUp" Tag="{Binding}"
                                                                           ToolTip="クリックでこの投稿者の動画を一覧表示"/>
                                                            </DockPanel>
                                                            <!-- 再生数・日付 ＋ 右端に小さなアイコンボタン（再生はサムネイルをクリック） -->
                                                            <DockPanel Margin="0,2,-6,0">
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="{Binding FavoriteIcon}" Foreground="{Binding FavoriteForeground}"
                                                                            Style="{StaticResource IconBtn}" FontSize="13.5"
                                                                            Click="ToggleFavoriteCard_Click" Tag="{Binding}"
                                                                            ToolTip="お気に入りに追加 / 解除"/>
                                                                    <Button Content="{Binding WatchLaterIcon}" Foreground="{Binding WatchLaterForeground}"
                                                                            Style="{StaticResource IconBtn}" FontSize="10.5"
                                                                            Click="ToggleWatchLaterCard_Click" Tag="{Binding}"
                                                                            ToolTip="後で見るリストに追加 / 解除"/>
                                                                    <Button Content="⋯" Style="{StaticResource IconBtn}" FontSize="14"
                                                                            Click="AddToPlaylistButton_Click" Tag="{Binding}"
                                                                            ToolTip="プレイリストへ追加 / 解除"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding MetaSummary}" Foreground="#9AA4B5" FontSize="11"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- ページ切り替え（前へ・ページ番号・次へ）。ボタンはコードで作る -->
                            <Border x:Name="PagerBar" Grid.Row="1" Padding="0,6,0,10" Visibility="Collapsed">
                                <StackPanel x:Name="PagerPanel" Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- ローディング＆空状態メッセージ -->
                        <Border x:Name="StatusOverlay" Background="#AA0D0F14" Visibility="Collapsed">
                            <Border Background="#E61B1E26" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                    CornerRadius="14" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="StatusTitle" Text="3サイトから動画を検索中..."
                                               Foreground="White" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="StatusSubtitle" Text="YouTube・ニコニコ動画・bilibili のデータを統合しています"
                                               Foreground="#94A3B8" FontSize="12.5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ========== 1.5 マイ視聴統計ダッシュボード画面 (Stats Dashboard View) ========== -->
                <ScrollViewer x:Name="StatsDashboardView" Background="#00000000" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Padding="28,22,28,36">
                    <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">
                        <DockPanel Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="📊 マイ視聴統計・メディア分析" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="このPC内に記録された視聴履歴・お気に入り・登録チャンネルの傾向レポート"
                                           Foreground="#94A3B8" FontSize="12.5" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="🎲 新しい動画をガチャで発掘" Style="{StaticResource PrimaryBtn}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" Click="VideoGacha_Click"/>
                        </DockPanel>

                        <!-- 上段：4枚のKPIサマリーカード -->
                        <UniformGrid Columns="4" Margin="0,0,0,20">
                            <Border Background="#0DFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="📺 総視聴動画数" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StatsTotalWatchedText" Text="0 本" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,6,0,4"/>
                                    <TextBlock x:Name="StatsTotalTimeText" Text="累計動画時間: 0分" Foreground="#818CF8" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0DFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="♥ 保存コレクション数" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StatsTotalSavedText" Text="0 本" Foreground="#F472B6" FontSize="26" FontWeight="Bold" Margin="0,6,0,4"/>
                                    <TextBlock x:Name="StatsSavedDetailText" Text="お気に入り 0 / 後で見る 0" Foreground="#9AA4B5" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0DFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="⭐ 登録チャンネル数" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StatsTotalSubsText" Text="0 ch" Foreground="#FACC15" FontSize="26" FontWeight="Bold" Margin="0,6,0,4"/>
                                    <TextBlock x:Name="StatsPlaylistsCountText" Text="カスタムリスト: 0個" Foreground="#9AA4B5" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#0DFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="🛡 広告・追跡ブロック" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="StatsTotalBlockedText" Text="0 件" Foreground="#34D399" FontSize="26" FontWeight="Bold" Margin="0,6,0,4"/>
                                    <TextBlock Text="今回のセッションで遮断" Foreground="#9AA4B5" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- 中段：サイト別比率 ＆ 推し投稿者ランキング -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左：5サイト別 視聴＆お気に入り比率 -->
                            <Border Grid.Column="0" Background="#0DFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="20,18" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="🌐 5サイト別 利用バランス" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>
                                    <ItemsControl x:Name="SiteStatsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <DockPanel Margin="0,0,0,5">
                                                        <TextBlock Text="{Binding Label}" Foreground="#E2E8F0" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                                   Foreground="#94A3B8" FontSize="12"/>
                                                    </DockPanel>
                                                    <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Height="10"
                                                                 Background="#00000000" Foreground="{Binding BarBrush}" BorderThickness="0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- 右：よく見る推し投稿者・チャンネル TOP 8 -->
                            <Border Grid.Column="1" Background="#0DFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1"
                                    CornerRadius="12" Padding="20,18" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="👑 よく見る推しチャンネル・投稿者 TOP 8" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <ItemsControl x:Name="TopCreatorsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#0AFFFFFF" CornerRadius="8" Padding="10,7" Margin="0,0,0,6">
                                                    <DockPanel>
                                                        <Border Width="24" Height="24" CornerRadius="12" Background="#1AFFFFFF" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Rank}" Foreground="#C7D2FE" FontSize="11.5" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border CornerRadius="4" Padding="6,2" Background="{Binding SiteBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SiteName}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                        <Button DockPanel.Dock="Right" Content="▶ 動画一覧" Style="{StaticResource ActionBtn}"
                                                                Padding="8,3" FontSize="11" Click="OpenCreatorFromStats_Click" Tag="{Binding}"/>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="#94A3B8"
                                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding Author}" Foreground="White" FontSize="13" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 下段：動画の長さスタイル分析 -->
                        <Border Background="#0DFFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1" CornerRadius="12" Padding="20,18">
                            <StackPanel>
                                <TextBlock Text="⏱ 視聴スタイルの長さ傾向（ショート vs MV・短編 vs 中編 vs 長尺・生配信）"
                                           Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>
                                <ItemsControl x:Name="DurationStatsItemsControl">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0AFFFFFF" CornerRadius="10" Padding="14,12" Margin="4,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" Foreground="#CBD5E1" FontSize="12.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Detail}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,6,0,6"/>
                                                    <ProgressBar Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Height="7"
                                                                 Background="#00000000" Foreground="{Binding BarBrush}" BorderThickness="0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== ⚙ 設定画面 ========== -->
                <ScrollViewer x:Name="SettingsView" Background="#00000000" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto" Padding="28,22,28,36">
                    <ScrollViewer.Resources>
                        <!-- 1つの設定（左に名前と説明、右に操作） -->
                        <Style x:Key="SettingRow" TargetType="DockPanel">
                            <Setter Property="Margin" Value="0,0,0,14"/>
                            <Setter Property="LastChildFill" Value="True"/>
                        </Style>
                        <Style x:Key="SettingName" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#E2E8F0"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                        <Style x:Key="SettingDesc" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#8B95A7"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Margin" Value="0,3,16,0"/>
                        </Style>
                        <Style x:Key="SettingCard" TargetType="Border">
                            <Setter Property="Background" Value="#0DFFFFFF"/>
                            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="CornerRadius" Value="12"/>
                            <Setter Property="Padding" Value="20,16,20,4"/>
                            <Setter Property="Margin" Value="0,0,0,16"/>
                        </Style>
                        <Style x:Key="SettingHeader" TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontSize" Value="15"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Margin" Value="0,0,0,14"/>
                        </Style>
                        <Style x:Key="SettingSwitch" TargetType="CheckBox">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border x:Name="Track" Width="42" Height="22" CornerRadius="11" Background="#33FFFFFF">
                                            <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8" Background="#CBD5E1"
                                                    HorizontalAlignment="Left" Margin="3,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Track" Property="Background" Value="#6366F1"/>
                                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="Knob" Property="Background" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Width" Value="170"/>
                            <Setter Property="Height" Value="30"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </ScrollViewer.Resources>

                    <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">
                        <TextBlock Text="⚙ 設定" Foreground="White" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="変えた設定はこのPCに保存され、次に起動した時もそのまま使われます"
                                   Foreground="#94A3B8" FontSize="12.5" Margin="0,4,0,18"/>

                        <!-- ▶ 再生 -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="▶ 再生" Style="{StaticResource SettingHeader}"/>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <ComboBox DockPanel.Dock="Right" SelectedIndex="{Binding SelectedIndex, ElementName=SpeedCombo, Mode=TwoWay}">
                                        <ComboBoxItem Content="0.75x"/>
                                        <ComboBoxItem Content="1.0x（標準）"/>
                                        <ComboBoxItem Content="1.25x"/>
                                        <ComboBoxItem Content="1.5x"/>
                                        <ComboBoxItem Content="2.0x"/>
                                    </ComboBox>
                                    <StackPanel>
                                        <TextBlock Text="再生速度" Style="{StaticResource SettingName}"/>
                                        <TextBlock Text="すべてのサイトの動画に使う速さ" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="SetAutoNext" DockPanel.Dock="Right" Style="{StaticResource SettingSwitch}" Checked="SettingSwitch_Click" Unchecked="SettingSwitch_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="連続再生" Style="{StaticResource SettingName}"/>
                                        <TextBlock Text="動画が終わったら、右の「次に再生」の動画を自動で再生する" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="SetShuffle" DockPanel.Dock="Right" Style="{StaticResource SettingSwitch}" Checked="SettingSwitch_Click" Unchecked="SettingSwitch_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="シャッフル再生" Style="{StaticResource SettingName}"/>
                                        <TextBlock Text="連続再生の時、次の動画をリストからランダムに選ぶ" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="SetMusicBgListen" DockPanel.Dock="Right" Style="{StaticResource SettingSwitch}" Checked="SettingSwitch_Click" Unchecked="SettingSwitch_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="Musicモードは下のバーで再生" Style="{StaticResource SettingName}"/>
                                        <TextBlock Text="Musicモードで曲を選んだ時、プレイヤー画面を開かずに一覧のまま下のバーで再生する" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 🎨 映像と音 -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="🎨 映像と音" Style="{StaticResource SettingHeader}"/>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <ComboBox DockPanel.Dock="Right" SelectedIndex="{Binding SelectedIndex, ElementName=AmbilightCombo, Mode=TwoWay}">
                                        <ComboBoxItem Content="🌈 標準発光"/>
                                        <ComboBoxItem Content="✨ 強発光 (Ultra)"/>
                                        <ComboBoxItem Content="🌙 ソフト発光"/>
                                        <ComboBoxItem Content="OFF (黒枠)"/>
                                    </ComboBox>
                                    <StackPanel>
                                        <TextBlock Text="アンビエントライト" Style="{StaticResource SettingName}"/>
                                        <TextBlock Text="動画の色に合わせて、周りをほんのり光らせる" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <ComboBox DockPanel.Dock="Right" SelectedIndex="{Binding SelectedIndex, ElementName=AudioGainCombo, Mode=TwoWay}">
                                        <ComboBoxItem Content="100% (標準)"/>
                                        <ComboBoxItem Content="150% 増幅"/>
                                        <ComboBoxItem Content="200% 増幅"/>
                                        <ComboBoxItem Content="300% 最大"/>
                                    </ComboBox>
                                    <StackPanel>
                                        <TextBlock Text="音量ブースト" Style="{StaticResource SettingName}"/>
                                        <TextBlock Text="音が小さい動画を大きくする" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <ComboBox DockPanel.Dock="Right" SelectedIndex="{Binding SelectedIndex, ElementName=AudioPresetCombo, Mode=TwoWay}">
                                        <ComboBoxItem Content="フラット (標準)"/>
                                        <ComboBoxItem Content="🎸 重低音強化"/>
                                        <ComboBoxItem Content="🎤 ボーカル明瞭"/>
                                        <ComboBoxItem Content="🌙 夜間小音量用"/>
                                    </ComboBox>
                                    <StackPanel>
                                        <TextBlock Text="音質" Style="{StaticResource SettingName}"/>
                                        <TextBlock Text="イコライザーで音の聞こえ方を変える" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <ComboBox DockPanel.Dock="Right" SelectedIndex="{Binding SelectedIndex, ElementName=DanmakuStyleCombo, Mode=TwoWay}">
                                        <ComboBoxItem Content="💬 標準"/>
                                        <ComboBoxItem Content="🔥 大きめ・濃密"/>
                                        <ComboBoxItem Content="🌙 控えめ・半透明"/>
                                        <ComboBoxItem Content="🚫 OFF"/>
                                    </ComboBox>
                                    <StackPanel>
                                        <TextBlock Text="弾幕コメント" Style="{StaticResource SettingName}"/>
                                        <TextBlock Text="YouTubeのコメントやライブチャットを動画の上に流す" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 📋 一覧・検索 -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="📋 一覧・検索" Style="{StaticResource SettingHeader}"/>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <ComboBox x:Name="SetShortsCombo" DockPanel.Dock="Right" SelectionChanged="SetShortsCombo_SelectionChanged">
                                        <ComboBoxItem Content="🚫 ショートを除外"/>
                                        <ComboBoxItem Content="📱 ショートだけ"/>
                                        <ComboBoxItem Content="🎬 すべて表示"/>
                                    </ComboBox>
                                    <StackPanel>
                                        <TextBlock Text="ショート動画" Style="{StaticResource SettingName}"/>
                                        <TextBlock Text="1分以下の短い縦型動画を一覧に出すかどうか" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <ComboBox DockPanel.Dock="Right" SelectedIndex="{Binding SelectedIndex, ElementName=SortCombo, Mode=TwoWay}">
                                        <ComboBoxItem Content="バランス順"/>
                                        <ComboBoxItem Content="再生数が多い順"/>
                                        <ComboBoxItem Content="動画が長い順"/>
                                        <ComboBoxItem Content="動画が短い順"/>
                                    </ComboBox>
                                    <StackPanel>
                                        <TextBlock Text="一覧の並び順" Style="{StaticResource SettingName}"/>
                                        <TextBlock Text="おすすめや検索結果の並べ方" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Text="読み込むサイト" Style="{StaticResource SettingName}"/>
                                    <TextBlock Text="OFFにしたサイトには通信しないので軽くなります（この画面を離れた時に読み込み直します）"
                                               Style="{StaticResource SettingDesc}" Margin="0,3,0,8"/>
                                    <UniformGrid x:Name="SiteToggleGrid" Columns="3" HorizontalAlignment="Left" Width="480"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 🛡 広告・ウィンドウ -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="🛡 広告・ウィンドウ" Style="{StaticResource SettingHeader}"/>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="SetAdBlock" DockPanel.Dock="Right" Style="{StaticResource SettingSwitch}" Checked="SettingSwitch_Click" Unchecked="SettingSwitch_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="広告ブロック" Style="{StaticResource SettingName}"/>
                                        <TextBlock x:Name="SetAdBlockDesc" Text="広告やトラッカーを止め、動画の広告を自動で飛ばす" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <CheckBox x:Name="SetTopmost" DockPanel.Dock="Right" Style="{StaticResource SettingSwitch}" Checked="SettingSwitch_Click" Unchecked="SettingSwitch_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="常に手前に表示" Style="{StaticResource SettingName}"/>
                                        <TextBlock Text="ほかのウィンドウより前にPrismilを表示する" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- 🔒 プライバシーとデータ -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="🔒 プライバシーとデータ" Style="{StaticResource SettingHeader}"/>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <Button DockPanel.Dock="Right" Content="🗑 履歴を消す" Style="{StaticResource ActionBtn}"
                                            Padding="12,6" VerticalAlignment="Center" Click="ClearHistorySetting_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="視聴履歴" Style="{StaticResource SettingName}"/>
                                        <TextBlock x:Name="SetHistoryDesc" Text="このPCに残っている視聴履歴をすべて消す" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <Button x:Name="BtnClearCookies" DockPanel.Dock="Right" Content="🧹 Cookie消去" Style="{StaticResource ActionBtn}"
                                            Padding="12,6" VerticalAlignment="Center" Click="ClearCookies_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="Cookie・キャッシュ" Style="{StaticResource SettingName}"/>
                                        <TextBlock Text="アプリ内のブラウザに残っているCookie・ログイン状態・キャッシュをリセットする" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Style="{StaticResource SettingRow}">
                                    <Button DockPanel.Dock="Right" Content="📂 開く" Style="{StaticResource ActionBtn}"
                                            Padding="12,6" VerticalAlignment="Center" Click="OpenLocalDataFolder_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="データの保存場所" Style="{StaticResource SettingName}"/>
                                        <TextBlock Text="お気に入り・履歴・設定を保存しているフォルダ (library.json) を開く" Style="{StaticResource SettingDesc}"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- ℹ 情報 -->
                        <Border Style="{StaticResource SettingCard}">
                            <StackPanel>
                                <TextBlock Text="ℹ このアプリについて" Style="{StaticResource SettingHeader}"/>
                                <TextBlock x:Name="AppVersionText" Text="Prismil" Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,10"/>
                                <TextBlock Text="ショートカット" Style="{StaticResource SettingName}"/>
                                <TextBlock Style="{StaticResource SettingDesc}" Margin="0,4,0,14" LineHeight="20"
                                           Text="Ctrl+L / Ctrl+F：検索　Ctrl+B：メニューの表示切替　Ctrl+M：ミニ窓　F11：全画面　T：シアターモード　Esc：元に戻す&#x0a;動画の上で　Space / K：再生・一時停止　← →：5秒移動　J / L：10秒移動　↑ ↓：音量　M：ミュート　F：全画面　0〜9：位置へ移動"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ========== 2. クリーン再生画面 (Zen Player View + BGMモード + ミニプレイヤー + サイドキュー) ========== -->
                <Grid x:Name="PlayerView" Background="#66000000" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="MiniPlayerBarRow" Height="0"/>
                        <RowDefinition x:Name="PlayerControlBarRow" Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 超小型ミニプレイヤー（PiP）モード時専用のドラッグ移動＆操作バー -->
                    <Border x:Name="MiniPlayerTopBar" Grid.Row="0" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="MiniPlayerTopBar_MouseLeftButtonDown" Cursor="SizeAll" Padding="8,0">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="⏯" Style="{StaticResource ActionBtn}" Padding="6,2" Margin="2,0"
                                        Click="PlayPauseButton_Click" ToolTip="再生 / 一時停止"/>
                                <Button Content="⏭" Style="{StaticResource ActionBtn}" Padding="6,2" Margin="2,0"
                                        Click="NextTrackButton_Click" ToolTip="次の動画を再生"/>
                                <Button Content="🎧" Style="{StaticResource ActionBtn}" Padding="6,2" Margin="2,0"
                                        Click="AudioOnlyToggle_Click" ToolTip="BGM（音声のみ）モード切替"/>
                                <Button Content="🗖 通常へ戻す" Style="{StaticResource PrimaryBtn}" Padding="8,2" Margin="4,0,0,0"
                                        Click="MiniPlayerButton_Click" ToolTip="通常ウィンドウサイズに戻す (Ctrl+M / Esc)"/>
                            </StackPanel>
                            <TextBlock x:Name="MiniBarTitleText" Text="Prismil Mini" Foreground="#E2E8F0" FontSize="11.5"
                                       FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,8,0"/>
                        </DockPanel>
                    </Border>

                    <!-- 通常プレイヤー上部コントロールバー -->
                    <Border x:Name="PlayerHeaderBar" Grid.Row="1" Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="10,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 一覧へ戻るボタン -->
                            <Button Grid.Column="0" Content="← 一覧へ" Style="{StaticResource ActionBtn}"
                                    Margin="0,0,10,0" Padding="9,5" Click="BackToGrid_Click" ToolTip="一覧に戻る"/>

                            <!-- 現在再生中の動画情報（残りの幅いっぱいを使い、入りきらない分は … で省略） -->
                            <DockPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" LastChildFill="True">
                                <Border x:Name="PlayerSiteBadge" DockPanel.Dock="Left" CornerRadius="5" Padding="7,2" Background="#E62117" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="PlayerSiteText" Text="YouTube" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                                </Border>
                                <TextBlock x:Name="PlayerTitleText" Text="動画を選択してください" Foreground="White"
                                           FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </DockPanel>

                            <!-- よく使うボタンだけを並べる。それ以外は ⚙ 設定 の中 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnPlayerSubscribe" Content="☆ 登録" Style="{StaticResource ActionBtn}"
                                        Margin="0,0,4,0" Padding="8,5" Click="PlayerToggleSubscribe_Click"
                                        ToolTip="この動画のチャンネル/投稿者をアプリ内にローカル登録"/>
                                <Button x:Name="BtnPlayerFavorite" Content="♡" Style="{StaticResource ActionBtn}"
                                        Margin="0,0,4,0" Padding="8,5" Click="PlayerToggleFavorite_Click" ToolTip="お気に入り追加/解除"/>
                                <Button x:Name="BtnPlayerWatchLater" Content="+後で" Style="{StaticResource ActionBtn}"
                                        Margin="0,0,4,0" Padding="8,5" Click="PlayerToggleWatchLater_Click" ToolTip="後で見る追加/解除"/>
                                <Button Content="📁+" Style="{StaticResource ActionBtn}"
                                        Margin="0,0,4,0" Padding="8,5" Click="PlayerAddToPlaylist_Click" ToolTip="カスタムプレイリストへ追加"/>

                                <Border Width="1" Height="22" Background="#26FFFFFF" Margin="6,0,10,0"/>

                                <Button x:Name="BtnOpenComments" Content="💬 コメント"
                                        Style="{StaticResource PrimaryBtn}" Margin="0,0,4,0" Padding="9,5"
                                        Click="ShowCommentsPanel_Click"
                                        ToolTip="右の欄にこの動画のコメントを一覧で表示する"/>
                                <Button x:Name="BtnToggleSideQueue" Content="📋" Style="{StaticResource ActionBtn}"
                                        Margin="0,0,4,0" Padding="8,5" Click="ToggleSideQueue_Click" ToolTip="右の欄（次の動画・コメント）を表示/非表示"/>
                                <Button x:Name="BtnTheaterMode" Content="🎭 シアター" Style="{StaticResource ActionBtn}"
                                        Margin="0,0,4,0" Padding="8,5" Click="TheaterModeButton_Click"
                                        ToolTip="メニューやバーを隠して、動画をウィンドウいっぱいに大きく表示 (T / Esc で戻る)"/>
                                <Button Content="⛶" Style="{StaticResource ActionBtn}" Margin="0,0,4,0"
                                        Padding="8,5" Click="FullScreenButton_Click" ToolTip="全画面表示 (F11)"/>
                                <Button x:Name="BtnPlayerSettings" Content="⚙ 設定" Style="{StaticResource ActionBtn}"
                                        Padding="9,5" Click="PlayerSettingsButton_Click"
                                        ToolTip="再生速度・ループ・音量・音質・映像効果・弾幕などの設定"/>
                            </StackPanel>

                            <!-- ⚙ 設定パネル（動画の上に重ねて開く。外をクリックすると閉じる） -->
                            <Popup x:Name="PlayerSettingsPopup" PlacementTarget="{Binding ElementName=BtnPlayerSettings}"
                                   Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border x:Name="PlayerStudioBar" Width="520" Background="#F2141824" BorderBrush="#33FFFFFF"
                                        BorderThickness="1" CornerRadius="12" Padding="16,12,16,14">
                                    <Border.Resources>
                                        <Style x:Key="SettingsHeader" TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#8B95A7"/>
                                            <Setter Property="FontSize" Value="11"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Margin" Value="2,8,0,6"/>
                                        </Style>
                                        <Style x:Key="SettingsLabel" TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#CBD5E1"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Margin" Value="2,0,6,0"/>
                                        </Style>
                                    </Border.Resources>
                                    <StackPanel>
                                        <!-- 再生 -->
                                        <TextBlock Text="▶ 再生" Style="{StaticResource SettingsHeader}" Margin="2,0,0,6"/>
                                        <WrapPanel>
                                            <TextBlock Text="速度" Style="{StaticResource SettingsLabel}"/>
                                            <ComboBox x:Name="SpeedCombo" Width="76" Height="28" VerticalContentAlignment="Center"
                                                      Margin="0,0,10,6" SelectionChanged="SpeedCombo_SelectionChanged"
                                                      ToolTip="再生速度 (3サイト共通)">
                                                <ComboBoxItem Content="0.75x" Tag="0.75"/>
                                                <ComboBoxItem Content="1.0x" Tag="1.0" IsSelected="True"/>
                                                <ComboBoxItem Content="1.25x" Tag="1.25"/>
                                                <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                                <ComboBoxItem Content="2.0x" Tag="2.0"/>
                                            </ComboBox>
                                            <Button x:Name="BtnLoopToggle" Content="🔁 ループ: OFF" Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,6,6" Padding="9,5" Click="LoopToggle_Click"
                                                    ToolTip="現在の動画を無限リピート再生"/>
                                            <Button x:Name="BtnAutoNextToggle" Content="⏭ 連続: ON" Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,6,6" Padding="9,5" Click="AutoNextToggle_Click"
                                                    ToolTip="動画終了時にサイドリストの次の動画をサイトをまたいで自動再生"/>
                                            <Button x:Name="BtnShuffleToggle" Content="🔀 シャッフル: OFF" Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,6,6" Padding="9,5" Click="ShuffleToggle_Click"
                                                    ToolTip="連続再生時にサイドリストからランダムに次の動画を選択"/>
                                            <Button x:Name="BtnABRepeat" Content="📍 A-B区間ループ: OFF" Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,6,6" Padding="9,5" Click="ABRepeatButton_Click"
                                                    ToolTip="1回目クリックでA地点(開始)、2回目でB地点(終了)を記録してその区間だけを無限ループ、3回目で解除"/>
                                        </WrapPanel>

                                        <!-- 表示 -->
                                        <TextBlock Text="🖥 表示" Style="{StaticResource SettingsHeader}"/>
                                        <WrapPanel>
                                            <Button x:Name="BtnAudioOnlyToggle" Content="🎧 BGMモード" Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,6,6" Padding="9,5" Click="AudioOnlyToggle_Click"
                                                    ToolTip="映像を隠して音楽・ラジオプレイヤーとして省電力再生"/>
                                            <Button x:Name="BtnMiniPlayer" Content="🗗 ミニ窓" Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,6,6" Padding="9,5" Click="MiniPlayerButton_Click"
                                                    ToolTip="画面の隅に置ける超小型ピクチャー・イン・ピクチャー窓に変形 (Ctrl+M)"/>
                                            <Button x:Name="BtnScreenshot" Content="📸 スクショ" Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,6,6" Padding="9,5" Click="Screenshot_Click"
                                                    ToolTip="現在の画面をピクチャフォルダ(Pictures/ZenTube)に保存"/>
                                            <Button x:Name="BtnMirrorToggle" Content="🪞 左右反転: OFF" Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,6,6" Padding="9,5" Click="MirrorToggle_Click"
                                                    ToolTip="動画の映像を左右反転（ミラー表示：ダンス練習などに最適）"/>
                                            <Button x:Name="BtnDimToggle" Content="🕶 減光フィルター: OFF" Style="{StaticResource ActionBtn}"
                                                    Margin="0,0,6,6" Padding="9,5" Click="DimToggle_Click"
                                                    ToolTip="画面の眩しさを抑えるシアター減光モード"/>
                                            <TextBlock Text="アンビエント" Style="{StaticResource SettingsLabel}" Margin="2,0,6,6"/>
                                            <ComboBox x:Name="AmbilightCombo" Width="130" Height="28" VerticalContentAlignment="Center"
                                                      Margin="0,0,6,6" SelectionChanged="AudioFxCombo_SelectionChanged"
                                                      ToolTip="動画の周囲にリアルタイムで映像の色をぼかして発光させる Ambient Light 効果">
                                                <ComboBoxItem Content="🌈 標準発光" Tag="vivid" IsSelected="True"/>
                                                <ComboBoxItem Content="✨ 強発光 (Ultra)" Tag="ultra"/>
                                                <ComboBoxItem Content="🌙 ソフト発光" Tag="soft"/>
                                                <ComboBoxItem Content="OFF (黒枠)" Tag="off"/>
                                            </ComboBox>
                                        </WrapPanel>

                                        <!-- 音 -->
                                        <TextBlock Text="🔊 音" Style="{StaticResource SettingsHeader}"/>
                                        <WrapPanel>
                                            <TextBlock Text="音量" Style="{StaticResource SettingsLabel}" Margin="2,0,6,6"/>
                                            <ComboBox x:Name="AudioGainCombo" Width="110" Height="28" VerticalContentAlignment="Center"
                                                      Margin="0,0,14,6" SelectionChanged="AudioFxCombo_SelectionChanged"
                                                      ToolTip="音が小さい動画を最大300%まで増幅">
                                                <ComboBoxItem Content="100% (標準)" Tag="1.0" IsSelected="True"/>
                                                <ComboBoxItem Content="150% 増幅" Tag="1.5"/>
                                                <ComboBoxItem Content="200% 増幅" Tag="2.0"/>
                                                <ComboBoxItem Content="300% 最大" Tag="3.0"/>
                                            </ComboBox>
                                            <TextBlock Text="音質" Style="{StaticResource SettingsLabel}" Margin="2,0,6,6"/>
                                            <ComboBox x:Name="AudioPresetCombo" Width="130" Height="28" VerticalContentAlignment="Center"
                                                      Margin="0,0,6,6" SelectionChanged="AudioFxCombo_SelectionChanged"
                                                      ToolTip="Web Audio API によるリアルタイム音質イコライザー">
                                                <ComboBoxItem Content="フラット (標準)" Tag="normal" IsSelected="True"/>
                                                <ComboBoxItem Content="🎸 重低音強化" Tag="bass"/>
                                                <ComboBoxItem Content="🎤 ボーカル明瞭" Tag="vocal"/>
                                                <ComboBoxItem Content="🌙 夜間小音量用" Tag="night"/>
                                            </ComboBox>
                                        </WrapPanel>

                                        <!-- 弾幕 -->
                                        <TextBlock Text="💬 弾幕コメント" Style="{StaticResource SettingsHeader}"/>
                                        <WrapPanel>
                                            <ComboBox x:Name="DanmakuStyleCombo" Width="160" Height="28" VerticalContentAlignment="Center"
                                                      Margin="0,0,8,0" SelectionChanged="DanmakuStyleCombo_SelectionChanged"
                                                      ToolTip="YouTubeコメント・Twitch/YouTubeライブチャットを画面上に横スクロール表示">
                                                <ComboBoxItem Content="💬 弾幕: 標準" Tag="normal" IsSelected="True"/>
                                                <ComboBoxItem Content="🔥 弾幕: 大きめ・濃密" Tag="bold"/>
                                                <ComboBoxItem Content="🌙 弾幕: 控えめ・半透明" Tag="subtle"/>
                                                <ComboBoxItem Content="🚫 弾幕: OFF" Tag="off"/>
                                            </ComboBox>
                                            <Border Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1" CornerRadius="6"
                                                    Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock x:Name="DanmakuStatusText" Text="💬 自動同期: ON" Foreground="#94A3B8" FontSize="11"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <!-- 下部：WebView2 クリーンプレイヤー ＋ BGMオーバーレイ ＋ 統合サイドリスト -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition x:Name="SideQueueColumn" Width="320"/>
                        </Grid.ColumnDefinitions>

                        <!-- WebView2 プレイヤー領域 + 音声のみ(BGM)モードオーバーレイ -->
                        <Grid Grid.Column="0" Background="Black">
                            <wv2:WebView2 x:Name="PlayerWebView" DefaultBackgroundColor="Black"/>

                            <!-- 🎧 BGM（音声のみ・省電力）モードの専用オーディオプレイヤー画面 -->
                            <Border x:Name="AudioOnlyOverlay" Background="#CC000000" Visibility="Collapsed">
                                <Border Background="#1AFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                        CornerRadius="20" Padding="36,28" MaxWidth="520"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border CornerRadius="14" ClipToBounds="True" Width="280" Height="158"
                                                BorderBrush="#4F46E5" BorderThickness="2" Margin="0,0,0,18">
                                            <Image x:Name="AudioOnlyThumb" Stretch="UniformToFill"/>
                                        </Border>
                                        <Border Background="#1AFFFFFF" CornerRadius="12" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,10">
                                            <TextBlock Text="🎧 BGM・省電力モード再生中（映像オフ）" Foreground="#A5B4FC" FontSize="11.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock x:Name="AudioOnlyTitle" Text="再生中のタイトル" Foreground="White"
                                                   FontSize="16" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center"
                                                   MaxWidth="420" MaxHeight="46" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="AudioOnlyAuthor" Text="" Foreground="#94A3B8"
                                                   FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,20"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="⏮ 前へ" Style="{StaticResource ActionBtn}" Padding="14,8" Margin="4,0"
                                                    Click="PrevTrackButton_Click"/>
                                            <Button Content="⏯ 再生 / 一時停止" Style="{StaticResource PrimaryBtn}" Padding="18,8" Margin="4,0"
                                                    Click="PlayPauseButton_Click"/>
                                            <Button Content="⏭ 次へ" Style="{StaticResource ActionBtn}" Padding="14,8" Margin="4,0"
                                                    Click="NextTrackButton_Click"/>
                                            <Button Content="🎬 映像を表示" Style="{StaticResource ActionBtn}" Padding="14,8" Margin="10,0,0,0"
                                                    Click="AudioOnlyToggle_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Border>
                        </Grid>

                        <!-- 右側：サイト横断サイドキュー・プレイリスト -->
                        <Border x:Name="SideQueueBorder" Grid.Column="1" Background="#1A000000" BorderBrush="#14FFFFFF" BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- サイドリスト切り替えタブ -->
                                <Border Grid.Row="0" Padding="10,10,10,8" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="NEXT UP / 連続再生キュー" Foreground="#9AA4B5" FontSize="10.5" FontWeight="Bold" Margin="2,0,0,6"/>
                                        <UniformGrid Columns="4">
                                            <Button x:Name="BtnQueueCurrent" Content="⏭ 次に" Style="{StaticResource ActionBtn}"
                                                    Margin="2" Padding="2,5" FontSize="11" Click="QueueTab_Click" Tag="Current"
                                                    ToolTip="次に再生：検索・一覧の続きと、視聴履歴をもとにしたおすすめ"/>
                                            <Button x:Name="BtnQueueWatchLater" Content="🕒 後で" Style="{StaticResource ActionBtn}"
                                                    Margin="2" Padding="2,5" FontSize="11" Click="QueueTab_Click" Tag="WatchLater"
                                                    ToolTip="後で見る"/>
                                            <Button x:Name="BtnQueueFavorites" Content="♥ お気に入り" Style="{StaticResource ActionBtn}"
                                                    Margin="2" Padding="2,5" FontSize="11" Click="QueueTab_Click" Tag="Favorites"/>
                                            <Button x:Name="BtnQueueComments" Content="💬 コメント" Style="{StaticResource ActionBtn}"
                                                    Margin="2" Padding="2,5" FontSize="11" Click="QueueTab_Click" Tag="Comments"
                                                    ToolTip="再生中の動画のコメントを一覧で見る"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- コンパクト動画リスト -->
                                <ItemsControl x:Name="SideQueueItemsControl" Grid.Row="1" Padding="8,6"
                                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True" Focusable="False"
                                                          Padding="{TemplateBinding Padding}">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="PlayVideoCard_Click" Tag="{Binding}" Cursor="Hand"
                                                    Background="Transparent" BorderThickness="0" Margin="0,3" Padding="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="ItemBd" CornerRadius="8" Background="#00000000" Padding="7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="108"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" Height="62" CornerRadius="6" ClipToBounds="True" Background="#33000000">
                                                                    <Grid>
                                                                        <Image Source="{Binding ThumbnailUrl, Converter={StaticResource ThumbConverter}, ConverterParameter=200}" Stretch="UniformToFill"/>
                                                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                                Margin="4,4,0,0" CornerRadius="4" Padding="5,1"
                                                                                Background="{Binding SiteBadgeBrush}">
                                                                            <TextBlock Text="{Binding SiteDisplayName}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>

                                                                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" Foreground="#E2E8F0" FontSize="12"
                                                                               FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="34"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Author}" Foreground="#9AA4B5" FontSize="10.5"
                                                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                                                    <TextBlock Text="{Binding QueueReason}" Foreground="#A5B4FC" FontSize="10"
                                                                               Margin="0,2,0,0">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasQueueReason}" Value="False">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="ItemBd" Property="Background" Value="#1AFFFFFF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 💬 コメント一覧（弾幕ではなく、普通のコメント欄として読む） -->
                                <Grid x:Name="CommentsPanel" Grid.Row="1" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="12,8,10,4" LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="↗ サイトで見る" Style="{StaticResource ActionBtn}"
                                                Padding="7,3" FontSize="10.5" Margin="6,0,0,0" Click="OpenComments_Click"
                                                ToolTip="サイトのページ（コメント欄・チャット）を別ウィンドウで開く"/>
                                        <Button x:Name="BtnCommentsSort" DockPanel.Dock="Right" Content="人気順" Style="{StaticResource ActionBtn}"
                                                Padding="7,3" FontSize="10.5" Click="CommentsSort_Click" Visibility="Collapsed"
                                                ToolTip="時間順 / 人気順（ニコる順）を切り替え"/>
                                        <TextBlock x:Name="CommentsStatusText" Text="" Foreground="#9AA4B5" FontSize="11"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>

                                    <ListBox x:Name="CommentsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                             Padding="6,2,6,8" HorizontalContentAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.ScrollChanged="CommentsList_ScrollChanged">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="CommentBd" CornerRadius="8" Padding="9,7" Margin="0,2" Background="#0DFFFFFF">
                                                    <StackPanel>
                                                        <DockPanel LastChildFill="True">
                                                            <Button DockPanel.Dock="Left" Content="{Binding TimeText}" Tag="{Binding}"
                                                                    Click="CommentTime_Click" Cursor="Hand" Margin="0,0,7,0"
                                                                    ToolTip="この場面へ移動">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border x:Name="Bd" Background="#336366F1" CornerRadius="4" Padding="5,0">
                                                                            <ContentPresenter TextElement.Foreground="#C7D2FE" TextElement.FontSize="10.5"
                                                                                              VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#666366F1"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasTime}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <TextBlock Text="{Binding Author}" Foreground="#A5B4FC" FontSize="11" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasAuthor}" Value="False">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Text}" Foreground="#E2E8F0" FontSize="12.5"
                                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{Binding Meta}" Foreground="#7C8799" FontSize="10" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

            </Grid>

            <!-- ========== 3. 常駐ボトム・ミュージックプレイヤーバー (Spotify / Apple Music 風デッキ) ========== -->
            <Border x:Name="MusicPlayerDockBar" Grid.Row="2" Visibility="Collapsed"
                    Background="#33000000" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="18,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：アルバムアート・サイトバッジ・曲名・アーティスト・お気に入り -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="52" Height="38" CornerRadius="7" ClipToBounds="True"
                                BorderBrush="#6366F1" BorderThickness="1" Background="#33000000" Margin="0,0,12,0"
                                Cursor="Hand" MouseLeftButtonUp="SwitchToPlayer_MouseUp" ToolTip="クリックでMV・プレイヤー画面を開く">
                            <Image x:Name="DockThumbImage" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="215">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Border x:Name="DockSiteBadge" CornerRadius="4" Padding="5,1" Background="#FF5500" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DockSiteText" Text="SoundCloud" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                </Border>
                                <TextBlock x:Name="DockTitleText" Text="再生中の楽曲" Foreground="White" FontSize="12.5"
                                           FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            </StackPanel>
                            <TextBlock x:Name="DockAuthorText" Text="Artist" Foreground="#94A3B8" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="BtnDockFavorite" Content="♡" Style="{StaticResource ActionBtn}"
                                Margin="10,0,0,0" Padding="8,4" FontSize="13" Click="PlayerToggleFavorite_Click"
                                ToolTip="お気に入りに追加 / 解除"/>
                    </StackPanel>

                    <!-- 中央：トランスポート操作（シャッフル / 前曲 / 再生・一時停止 / 次曲 / ループ） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BtnDockShuffle" Content="🔀" Style="{StaticResource ActionBtn}"
                                Padding="9,6" Margin="4,0" Click="ShuffleToggle_Click" ToolTip="シャッフル再生 ON/OFF"/>
                        <Button Content="⏮ 前へ" Style="{StaticResource ActionBtn}"
                                Padding="12,6" Margin="4,0" Click="PrevTrackButton_Click" ToolTip="前の曲へ"/>
                        <Button Content="⏯ 再生 / 一時停止" Style="{StaticResource PrimaryBtn}"
                                Padding="18,6" Margin="6,0" Click="PlayPauseButton_Click" ToolTip="再生 / 一時停止"/>
                        <Button Content="⏭ 次へ" Style="{StaticResource ActionBtn}"
                                Padding="12,6" Margin="4,0" Click="NextTrackButton_Click" ToolTip="次の曲へ"/>
                        <Button x:Name="BtnDockLoop" Content="🔁" Style="{StaticResource ActionBtn}"
                                Padding="9,6" Margin="4,0" Click="LoopToggle_Click" ToolTip="1曲リピート ON/OFF"/>
                    </StackPanel>

                    <!-- 右：ワンクリック音質EQ・MV画面表示・停止 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnDockEqBass" Content="🎸 重低音" Style="{StaticResource ActionBtn}"
                                Padding="9,5" Margin="0,0,5,0" Click="DockEqPreset_Click" Tag="bass"
                                ToolTip="重低音強化イコライザー (ON/OFF)"/>
                        <Button x:Name="BtnDockEqVocal" Content="🎤 ボーカル" Style="{StaticResource ActionBtn}"
                                Padding="9,5" Margin="0,0,10,0" Click="DockEqPreset_Click" Tag="vocal"
                                ToolTip="ボーカル明瞭化イコライザー (ON/OFF)"/>
                        <Button Content="🎬 MV画面を開く" Style="{StaticResource PrimaryBtn}"
                                Padding="12,5" Margin="0,0,6,0" Click="SwitchToPlayer_Click"
                                ToolTip="アンビエントライト付きフルプレイヤー画面を表示"/>
                        <Button Content="✕" Style="{StaticResource ActionBtn}"
                                Padding="8,5" Click="StopPlayback_Click" ToolTip="再生を停止してバーを閉じる"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 自動更新のお知らせ（新しい版のダウンロードが済んだら右下に出る） -->
        <Border x:Name="UpdateBanner" Grid.ColumnSpan="2" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                Background="#F21C1F27" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="UpdateBannerTitle" Text="新しいバージョンの準備ができました" Foreground="White"
                           FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Text="再起動すると更新されます（次に起動した時にも自動で更新されます）" Foreground="#9AA4B5"
                           FontSize="11.5" Margin="0,4,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="あとで" Style="{StaticResource ActionBtn}" Padding="12,5" Margin="0,0,8,0"
                            Click="UpdateLater_Click"/>
                    <Button Content="今すぐ再起動" Style="{StaticResource PrimaryBtn}" Padding="12,5"
                            Click="UpdateRestart_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 短いお知らせ（ログインが必要な動画を飛ばした時など）。数秒で消える -->
        <Border x:Name="NoticeToast" Grid.ColumnSpan="2" Visibility="Collapsed" IsHitTestVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,84,0,0" MaxWidth="640"
                Background="#F21C1F27" BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" Padding="16,10">
            <TextBlock x:Name="NoticeToastText" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
