<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- アプリの名前とアイコン -->
    <AssemblyName>Prismil</AssemblyName>
    <Product>Prismil</Product>
    <AssemblyTitle>Prismil</AssemblyTitle>
    <ApplicationIcon>Assets\prismil.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <!-- 自動更新（Velopack）を最初に動かすため、Program.Main から起動する -->
    <StartupObject>ZenTube.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\prismil.ico" />
    <Resource Include="Assets\prismil.png" />
  </ItemGroup>

</Project>
